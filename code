#include <iostream>
#include <string>

using namespace std;

// Encrypts or decrypts text using Caesar Cipher logic
string caesarCipher(string text, int shift) {
    string result = "";

    // Normalize shift within 0-25 bounds (handles negative numbers)
    shift = (shift % 26 + 26) % 26;

    for (char c : text) {
        if (c >= 'A' && c <= 'Z') {
            result += (c - 'A' + shift) % 26 + 'A';
        } else if (c >= 'a' && c <= 'z') {
            result += (c - 'a' + shift) % 26 + 'a';
        } else {
            result += c; // Keep spaces, digits, and special characters unchanged
        }
    }

    return result;
}

int main() {
    int choice;
    string text;

    cout << "1. Encrypt\n2. Decrypt\nSelect (1 or 2): ";
    cin >> choice;
    cin.ignore(); // Clean up newline before reading text line

    cout << "Enter text: ";
    getline(cin, text);

    // Shift forward by 13 for encrypt, backward by 13 for decrypt
    int shift = (choice == 2) ? -13 : 13;

    string output = caesarCipher(text, shift);

    cout << "Result: " << output << "\n";

    return 0;
}
